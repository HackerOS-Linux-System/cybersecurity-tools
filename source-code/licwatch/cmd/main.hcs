using <0.6>
get <std:string> import <str_trim::str_split::str_contains::str_starts_with::str_replace::str_join::str_repeat::str_to_int::str_ends_with::str_to_float::str_index_of>
get <std:io> import <read_file_or::write_file_ok::file_readable>
get <std:fs> import <list_dir_or_empty::create_dir_ok>

!! ── cybersec prelude (HackerScript) — shared helpers, 0.2 ───────────────────
!! Authorised testing only: run these tools against systems you own or are
!! explicitly permitted to assess.

!! always succeeds at the run_command level (so a non-zero exit inside
!! `cmd`, e.g. a `grep` with no match, never turns into a silent Err /
!! empty string) — the real exit status is not needed by these tools,
!! which only look at stdout text.
fun sh(cmd: Str) -> Str [
    match run_command("/bin/sh".to_string(), ["-c".to_string(), cmd + "; true"]) [
        Ok(o) -> [ end str_trim(o) ]
        Err(_e) -> [ end "" ]
    ]
]

fun have_cmd(name: Str) -> Bool [
    end command_ok(name)
]

fun command_ok(name: Str) -> Bool [
    end sh("command -v " + sh_quote(name) + " >/dev/null 2>&1 && echo y || echo n") == "y"
]

fun sh_quote(s: Str) -> Str [
    end "'" + str_replace(s, "'", "'\\''") + "'"
]

fun arg_has(args: List<Str>, flag: Str) -> Bool [
    let i = 0
    let n = args.len()
    while i < n [
        if args[i] == flag [
            end true
        ]
        i = i + 1
    ]
    end false
]

fun arg_val(args: List<Str>, key: Str, dflt: Str) -> Str [
    let pre: Str = key + "="
    let i = 0
    let n = args.len()
    while i < n [
        let a: Str = args[i].clone()
        if str_starts_with(a.clone(), pre.clone()) [
            end a.slice(pre.len(), a.len())
        ]
        if a == key and i + 1 < n [
            end args[i + 1].clone()
        ]
        i = i + 1
    ]
    end dflt
]

fun positional(args: List<Str>, n: Int) -> Str [
    let seen = 0
    let i = 0
    let total = args.len()
    while i < total [
        let a: Str = args[i].clone()
        if not str_starts_with(a.clone(), "-") [
            seen = seen + 1
            if seen == n [
                end a
            ]
        ]
        i = i + 1
    ]
    end ""
]

fun c_cyan(s: Str) -> Str [ end "\e[36m" + s + "\e[0m" ]
fun c_green(s: Str) -> Str [ end "\e[32m" + s + "\e[0m" ]
fun c_yellow(s: Str) -> Str [ end "\e[33m" + s + "\e[0m" ]
fun c_red(s: Str) -> Str [ end "\e[31m" + s + "\e[0m" ]
fun c_dim(s: Str) -> Str [ end "\e[2m" + s + "\e[0m" ]
fun c_bold(s: Str) -> Str [ end "\e[1m" + s + "\e[0m" ]

fun banner(name: Str, ver: Str, desc: Str) [
    log("")
    log(c_cyan("  | " + name) + c_dim("  v" + ver + "  -  " + desc))
    log(c_dim("  " + str_repeat("-", 58)))
]

fun ok_line(msg: Str) -> Int [
    log("  " + c_green("PASS") + "  " + msg)
    end 0
]

fun warn_line(msg: Str) -> Int [
    log("  " + c_yellow("WARN") + "  " + msg)
    end 1
]

fun bad_line(msg: Str) -> Int [
    log("  " + c_red("FAIL") + "  " + msg)
    end 2
]

fun info_line(msg: Str) [
    log("  " + c_cyan("INFO") + "  " + msg)
]

fun pad_right(s: Str, width: Int) -> Str [
    let out: Str = s.clone()
    while out.len() < width [
        out = out + " "
    ]
    end out
]

fun summary(tool: Str, checks: Int, warns: Int, fails: Int) -> Int [
    log(c_dim("  " + str_repeat("-", 58)))
    let line = tool + ": " + checks.to_string() + " checks, " + warns.to_string() + " warnings, " + fails.to_string() + " failures"
    if fails > 0 [
        log("  " + c_red(line))
        end 2
    ]
    if warns > 0 [
        log("  " + c_yellow(line))
        end 1
    ]
    log("  " + c_green(line))
    end 0
]

fun home_dir() -> Str [
    match env_var("HOME") [
        Some(v) -> [ end v ]
        None -> [ end "/root" ]
    ]
]

fun state_dir(tool: Str) -> Str [
    let d = home_dir() + "/.hackeros/" + tool
    sh("mkdir -p " + sh_quote(d))
    end d
]

fun opt_int_or(o: Option<Int>, dflt: Int) -> Int [
    match o [
        Some(v) -> [ end v ]
        None -> [ end dflt ]
    ]
]

fun arg_int(args: List<Str>, key: Str, dflt: Int) -> Int [
    end opt_int_or(str_to_int(arg_val(args, key, dflt.to_string())), dflt)
]

!! licwatch — open-source license summarizer / SBOM-lite for a source tree
!! Usage: licwatch <dir>

fun license_of_text(text: Str) -> Str [
    if str_contains(text, "GNU GENERAL PUBLIC LICENSE") and str_contains(text, "Version 3") [ end "GPL-3.0" ]
    if str_contains(text, "GNU GENERAL PUBLIC LICENSE") and str_contains(text, "Version 2") [ end "GPL-2.0" ]
    if str_contains(text, "GNU LESSER GENERAL PUBLIC LICENSE") [ end "LGPL" ]
    if str_contains(text, "Mozilla Public License") [ end "MPL-2.0" ]
    if str_contains(text, "Apache License") and str_contains(text, "2.0") [ end "Apache-2.0" ]
    if str_contains(text, "Permission is hereby granted, free of charge") [ end "MIT" ]
    if str_contains(text, "Redistribution and use in source and binary forms") [ end "BSD" ]
    if str_contains(text, "DO WHAT THE FUCK YOU WANT") [ end "WTFPL" ]
    if str_contains(text, "Unlicense") [ end "Unlicense" ]
    end "UNKNOWN"
]

fun copyleft(lic: Str) -> Bool [
    end lic == "GPL-3.0" or lic == "GPL-2.0" or lic == "LGPL" or lic == "MPL-2.0"
]

fun main() [
    let a = args()
    let dir = positional(a, 1)
    if dir == "" or arg_has(a, "--help") [
        banner("licwatch", "0.2.0", "license summarizer for a source tree")
        log("  licwatch <dir>")
        end
    ]
    banner("licwatch", "0.2.0", dir)
    let names = sh("find " + sh_quote(dir) + " -maxdepth 4 -iname 'LICENSE*' -o -maxdepth 4 -iname 'COPYING*' 2>/dev/null")
    let files = str_split(names, "\n")
    let i = 0
    let n = files.len()
    let copyleft_hit = 0
    let total = 0
    while i < n [
        let f: Str = str_trim(files[i].clone())
        if f != "" [
            let text = read_file_or(f, "")
            let lic = license_of_text(text)
            total = total + 1
            if copyleft(lic) [
                copyleft_hit = copyleft_hit + 1
                log("  " + c_yellow(pad_right(lic, 12)) + f)
            ] else [
                log("  " + c_green(pad_right(lic, 12)) + f)
            ]
        ]
        i = i + 1
    ]
    log(c_dim("  " + str_repeat("-", 58)))
    log("  " + total.to_string() + " license file(s) found, " + copyleft_hit.to_string() + " copyleft")
    if copyleft_hit > 0 [
        log("  " + c_yellow("review copyleft terms before closed-source redistribution"))
    ]
]
