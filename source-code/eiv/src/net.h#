extern static [c, "eivnet"] is
    fn eiv_req_reset()
    fn eiv_req_push(b: int)
    fn eiv_resp_len() -> int
    fn eiv_resp_byte(i: int) -> int
    fn eiv_resp_text() -> string
    fn eiv_tcp_connect(ip: string, port: int, timeout_ms: int) -> int
    fn eiv_close(fd: int)
    fn eiv_tcp_exchange(fd: int, timeout_ms: int) -> int
    fn eiv_udp_exchange(ip: string, port: int, timeout_ms: int) -> int
end

;; load `plen` bytes of `payload` into the request buffer (plen = 0 -> empty request)
fn load_request(payload: bytes, plen: int) is
    eiv_req_reset()
    let mut i: int = 0
    while i < plen is
        eiv_req_push(payload[i])
        i = i + 1
    end
end

;; connect; returns fd or -1
fn tcp_connect(ip: string, port: int, timeout_ms: int) -> int is
    return eiv_tcp_connect(ip, port, timeout_ms)
end

fn close(fd: int) is
    eiv_close(fd)
end

;; send payload on fd and read one reply; returns reply length (reply bytes: resp_byte(i))
fn tcp_exchange(fd: int, payload: bytes, plen: int, timeout_ms: int) -> int is
    load_request(payload, plen)
    return eiv_tcp_exchange(fd, timeout_ms)
end

;; connect, read the banner the server volunteers, close; "" when nothing came back
fn tcp_banner(ip: string, port: int, timeout_ms: int) -> string is
    let fd: int = eiv_tcp_connect(ip, port, timeout_ms)
    if fd < 0 is
        return ""
    end
    eiv_req_reset()
    let n: int = eiv_tcp_exchange(fd, timeout_ms)
    eiv_close(fd)
    if n > 0 is
        return eiv_resp_text()
    end
    return ""
end

;; one UDP datagram out, one reply back; returns reply length (0 = silence)
fn udp_probe(ip: string, port: int, payload: bytes, plen: int, timeout_ms: int) -> int is
    load_request(payload, plen)
    let n: int = eiv_udp_exchange(ip, port, timeout_ms)
    if n < 0 is
        return 0
    end
    return n
end

fn resp_byte(i: int) -> int is
    return eiv_resp_byte(i)
end

;; zeroed buffer (h# 0.9.0 has no b"\x00" * N literal; bytes is an int array)
fn zero_bytes(n: int) -> bytes is
    let mut out: bytes = []
    let mut i: int = 0
    while i < n is
        out = array_push(out, 0)
        i = i + 1
    end
    return out
end
