using <0.6>
get <std:string> import <str_trim::str_split::str_contains::str_starts_with::str_replace::str_join::str_repeat::str_to_int::str_ends_with::str_to_float::str_index_of>
get <std:io> import <read_file_or::write_file_ok::file_readable>
get <std:fs> import <list_dir_or_empty::create_dir_ok>

!! ── cybersec prelude (HackerScript) — shared helpers, 0.2 ───────────────────
!! Authorised testing only: run these tools against systems you own or are
!! explicitly permitted to assess.

!! always succeeds at the run_command level (so a non-zero exit inside
!! `cmd`, e.g. a `grep` with no match, never turns into a silent Err /
!! empty string) — the real exit status is not needed by these tools,
!! which only look at stdout text.
fun sh(cmd: Str) -> Str [
    match run_command("/bin/sh".to_string(), ["-c".to_string(), cmd + "; true"]) [
        Ok(o) -> [ end str_trim(o) ]
        Err(_e) -> [ end "" ]
    ]
]

fun have_cmd(name: Str) -> Bool [
    end command_ok(name)
]

fun command_ok(name: Str) -> Bool [
    end sh("command -v " + sh_quote(name) + " >/dev/null 2>&1 && echo y || echo n") == "y"
]

fun sh_quote(s: Str) -> Str [
    end "'" + str_replace(s, "'", "'\\''") + "'"
]

fun arg_has(args: List<Str>, flag: Str) -> Bool [
    let i = 0
    let n = args.len()
    while i < n [
        if args[i] == flag [
            end true
        ]
        i = i + 1
    ]
    end false
]

fun arg_val(args: List<Str>, key: Str, dflt: Str) -> Str [
    let pre: Str = key + "="
    let i = 0
    let n = args.len()
    while i < n [
        let a: Str = args[i].clone()
        if str_starts_with(a.clone(), pre.clone()) [
            end a.slice(pre.len(), a.len())
        ]
        if a == key and i + 1 < n [
            end args[i + 1].clone()
        ]
        i = i + 1
    ]
    end dflt
]

fun positional(args: List<Str>, n: Int) -> Str [
    let seen = 0
    let i = 0
    let total = args.len()
    while i < total [
        let a: Str = args[i].clone()
        if not str_starts_with(a.clone(), "-") [
            seen = seen + 1
            if seen == n [
                end a
            ]
        ]
        i = i + 1
    ]
    end ""
]

fun c_cyan(s: Str) -> Str [ end "\e[36m" + s + "\e[0m" ]
fun c_green(s: Str) -> Str [ end "\e[32m" + s + "\e[0m" ]
fun c_yellow(s: Str) -> Str [ end "\e[33m" + s + "\e[0m" ]
fun c_red(s: Str) -> Str [ end "\e[31m" + s + "\e[0m" ]
fun c_dim(s: Str) -> Str [ end "\e[2m" + s + "\e[0m" ]
fun c_bold(s: Str) -> Str [ end "\e[1m" + s + "\e[0m" ]

fun banner(name: Str, ver: Str, desc: Str) [
    log("")
    log(c_cyan("  | " + name) + c_dim("  v" + ver + "  -  " + desc))
    log(c_dim("  " + str_repeat("-", 58)))
]

fun ok_line(msg: Str) -> Int [
    log("  " + c_green("PASS") + "  " + msg)
    end 0
]

fun warn_line(msg: Str) -> Int [
    log("  " + c_yellow("WARN") + "  " + msg)
    end 1
]

fun bad_line(msg: Str) -> Int [
    log("  " + c_red("FAIL") + "  " + msg)
    end 2
]

fun info_line(msg: Str) [
    log("  " + c_cyan("INFO") + "  " + msg)
]

fun pad_right(s: Str, width: Int) -> Str [
    let out: Str = s.clone()
    while out.len() < width [
        out = out + " "
    ]
    end out
]

fun summary(tool: Str, checks: Int, warns: Int, fails: Int) -> Int [
    log(c_dim("  " + str_repeat("-", 58)))
    let line = tool + ": " + checks.to_string() + " checks, " + warns.to_string() + " warnings, " + fails.to_string() + " failures"
    if fails > 0 [
        log("  " + c_red(line))
        end 2
    ]
    if warns > 0 [
        log("  " + c_yellow(line))
        end 1
    ]
    log("  " + c_green(line))
    end 0
]

fun home_dir() -> Str [
    match env_var("HOME") [
        Some(v) -> [ end v ]
        None -> [ end "/root" ]
    ]
]

fun state_dir(tool: Str) -> Str [
    let d = home_dir() + "/.hackeros/" + tool
    sh("mkdir -p " + sh_quote(d))
    end d
]

fun opt_int_or(o: Option<Int>, dflt: Int) -> Int [
    match o [
        Some(v) -> [ end v ]
        None -> [ end dflt ]
    ]
]

fun arg_int(args: List<Str>, key: Str, dflt: Int) -> Int [
    end opt_int_or(str_to_int(arg_val(args, key, dflt.to_string())), dflt)
]

!! dnsshield — DNS resolver sanity checker + blocklist lookup for a domain
!! Usage: dnsshield check <domain>   |   dnsshield doh <domain> [--server=cloudflare|google|quad9]

fun doh_url(server: Str) -> Str [
    if server == "google" [ end "https://dns.google/resolve" ]
    if server == "quad9" [ end "https://dns.quad9.net:5053/dns-query" ]
    end "https://cloudflare-dns.com/dns-query"
]

fun classic_resolve(domain: Str) -> Str [
    end sh("getent ahosts " + sh_quote(domain) + " 2>/dev/null | awk '{print $1}' | sort -u")
]

fun check_blocklist_hint(domain: Str) -> Str [
    !! heuristic only: known-suspicious TLDs / patterns, NOT a live reputation API call
    let susp = [".zip", ".top", ".gq", ".tk", ".xyz", ".click", ".country", ".work", ".support"]
    let i = 0
    let n = susp.len()
    while i < n [
        if str_ends_with(domain, susp[i].clone()) [
            end "TLD commonly abused for malvertising/phishing: " + susp[i].clone()
        ]
        i = i + 1
    ]
    end ""
]

fun usage() [
    banner("dnsshield", "0.2.0", "DNS resolution sanity + heuristics")
    log("  dnsshield check <domain>                classic resolver + heuristics")
    log("  dnsshield doh <domain> [--server=cloudflare|google|quad9]   DNS-over-HTTPS lookup")
]

fun main() [
    let a = args()
    let cmd = positional(a, 1)
    let domain = positional(a, 2)
    if cmd == "" or domain == "" or arg_has(a, "--help") [
        usage()
        end
    ]
    if cmd == "check" [
        banner("dnsshield check", "0.2.0", domain)
        let ips = classic_resolve(domain)
        if ips == "" [
            log("  " + c_red("FAIL") + "  NXDOMAIN or no answer for " + domain)
            exit(2)
        ]
        log("  " + c_green("PASS") + "  resolves to:")
        log(sh("printf %s " + sh_quote(ips) + " | sed 's/^/    /'"))
        let hint = check_blocklist_hint(domain)
        if hint != "" [
            log("  " + c_yellow("WARN") + "  " + hint)
        ]
        let rdns = sh("getent hosts " + sh_quote(str_split(ips, "\n")[0].clone()) + " 2>/dev/null | awk '{print $2}'")
        if rdns == "" [
            log("  " + c_yellow("WARN") + "  no reverse DNS (PTR) for the first resolved address")
        ] else [
            log("  " + c_green("PASS") + "  PTR: " + rdns)
        ]
        end
    ]
    if cmd == "doh" [
        let server = arg_val(a, "--server", "cloudflare")
        banner("dnsshield doh", "0.2.0", server)
        if not have_cmd("curl") [
            log(c_red("error:") + " curl not found")
            exit(1)
        ]
        let url = doh_url(server) + "?name=" + domain + "&type=A"
        let resp = sh("curl -sS -H 'accept: application/dns-json' " + sh_quote(url) + " --max-time 6 2>/dev/null")
        if resp == "" [
            log(c_red("  no response"))
            exit(2)
        ]
        log(resp)
        end
    ]
    usage()
    exit(1)
]
