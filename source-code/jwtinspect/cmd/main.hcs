using <0.6>
get <std:string> import <str_trim::str_split::str_contains::str_starts_with::str_replace::str_join::str_repeat::str_to_int::str_ends_with::str_to_float::str_index_of>
get <std:io> import <read_file_or::write_file_ok::file_readable>
get <std:fs> import <list_dir_or_empty::create_dir_ok>

!! ── cybersec prelude (HackerScript) — shared helpers, 0.2 ───────────────────
!! Authorised testing only: run these tools against systems you own or are
!! explicitly permitted to assess.

!! always succeeds at the run_command level (so a non-zero exit inside
!! `cmd`, e.g. a `grep` with no match, never turns into a silent Err /
!! empty string) — the real exit status is not needed by these tools,
!! which only look at stdout text.
fun sh(cmd: Str) -> Str [
    match run_command("/bin/sh".to_string(), ["-c".to_string(), cmd + "; true"]) [
        Ok(o) -> [ end str_trim(o) ]
        Err(_e) -> [ end "" ]
    ]
]

fun have_cmd(name: Str) -> Bool [
    end command_ok(name)
]

fun command_ok(name: Str) -> Bool [
    end sh("command -v " + sh_quote(name) + " >/dev/null 2>&1 && echo y || echo n") == "y"
]

fun sh_quote(s: Str) -> Str [
    end "'" + str_replace(s, "'", "'\\''") + "'"
]

fun arg_has(args: List<Str>, flag: Str) -> Bool [
    let i = 0
    let n = args.len()
    while i < n [
        if args[i] == flag [
            end true
        ]
        i = i + 1
    ]
    end false
]

fun arg_val(args: List<Str>, key: Str, dflt: Str) -> Str [
    let pre: Str = key + "="
    let i = 0
    let n = args.len()
    while i < n [
        let a: Str = args[i].clone()
        if str_starts_with(a.clone(), pre.clone()) [
            end a.slice(pre.len(), a.len())
        ]
        if a == key and i + 1 < n [
            end args[i + 1].clone()
        ]
        i = i + 1
    ]
    end dflt
]

fun positional(args: List<Str>, n: Int) -> Str [
    let seen = 0
    let i = 0
    let total = args.len()
    while i < total [
        let a: Str = args[i].clone()
        if not str_starts_with(a.clone(), "-") [
            seen = seen + 1
            if seen == n [
                end a
            ]
        ]
        i = i + 1
    ]
    end ""
]

fun c_cyan(s: Str) -> Str [ end "\e[36m" + s + "\e[0m" ]
fun c_green(s: Str) -> Str [ end "\e[32m" + s + "\e[0m" ]
fun c_yellow(s: Str) -> Str [ end "\e[33m" + s + "\e[0m" ]
fun c_red(s: Str) -> Str [ end "\e[31m" + s + "\e[0m" ]
fun c_dim(s: Str) -> Str [ end "\e[2m" + s + "\e[0m" ]
fun c_bold(s: Str) -> Str [ end "\e[1m" + s + "\e[0m" ]

fun banner(name: Str, ver: Str, desc: Str) [
    log("")
    log(c_cyan("  | " + name) + c_dim("  v" + ver + "  -  " + desc))
    log(c_dim("  " + str_repeat("-", 58)))
]

fun ok_line(msg: Str) -> Int [
    log("  " + c_green("PASS") + "  " + msg)
    end 0
]

fun warn_line(msg: Str) -> Int [
    log("  " + c_yellow("WARN") + "  " + msg)
    end 1
]

fun bad_line(msg: Str) -> Int [
    log("  " + c_red("FAIL") + "  " + msg)
    end 2
]

fun info_line(msg: Str) [
    log("  " + c_cyan("INFO") + "  " + msg)
]

fun pad_right(s: Str, width: Int) -> Str [
    let out: Str = s.clone()
    while out.len() < width [
        out = out + " "
    ]
    end out
]

fun summary(tool: Str, checks: Int, warns: Int, fails: Int) -> Int [
    log(c_dim("  " + str_repeat("-", 58)))
    let line = tool + ": " + checks.to_string() + " checks, " + warns.to_string() + " warnings, " + fails.to_string() + " failures"
    if fails > 0 [
        log("  " + c_red(line))
        end 2
    ]
    if warns > 0 [
        log("  " + c_yellow(line))
        end 1
    ]
    log("  " + c_green(line))
    end 0
]

fun home_dir() -> Str [
    match env_var("HOME") [
        Some(v) -> [ end v ]
        None -> [ end "/root" ]
    ]
]

fun state_dir(tool: Str) -> Str [
    let d = home_dir() + "/.hackeros/" + tool
    sh("mkdir -p " + sh_quote(d))
    end d
]

fun opt_int_or(o: Option<Int>, dflt: Int) -> Int [
    match o [
        Some(v) -> [ end v ]
        None -> [ end dflt ]
    ]
]

fun arg_int(args: List<Str>, key: Str, dflt: Int) -> Int [
    end opt_int_or(str_to_int(arg_val(args, key, dflt.to_string())), dflt)
]

!! jwtinspect — decodes a JWT (header + payload, base64url) and flags risky claims.
!! Does NOT verify the signature (no key material) — inspection only.
!! Usage: jwtinspect <token>

fun b64url_decode(s: Str) -> Str [
    let padded: Str = str_replace(str_replace(s, "-", "+"), "_", "/")
    let rem = padded.len() - ((padded.len() / 4) * 4)
    let pad: Str = ""
    if rem == 2 [ pad = "==" ]
    if rem == 3 [ pad = "=" ]
    end sh("printf %s " + sh_quote(padded + pad) + " | base64 -d 2>/dev/null")
]

fun usage() [
    banner("jwtinspect", "0.2.0", "JWT decoder & risky-claim checker (no signature check)")
    log("  jwtinspect <token>")
]

fun main() [
    let a = args()
    let token = positional(a, 1)
    if token == "" or arg_has(a, "--help") [
        usage()
        end
    ]
    let parts = str_split(token, ".")
    if parts.len() < 2 [
        log(c_red("error:") + " not a JWT (expected header.payload.signature)")
        exit(1)
    ]
    banner("jwtinspect", "0.2.0", "decoded token")
    let header = b64url_decode(parts[0].clone())
    let payload = b64url_decode(parts[1].clone())
    log(c_bold("  header"))
    log("    " + header)
    log(c_bold("  payload"))
    log("    " + payload)

    let warns = 0
    let fails = 0
    let checks = 0

    checks = checks + 1
    if str_contains(header, "\"alg\":\"none\"") or str_contains(header, "\"alg\": \"none\"") [
        fails = fails + 1
        bad_line("alg=none — signature not required by this token; never accept that server-side")
    ] else [
        ok_line("alg is not 'none'")
    ]

    checks = checks + 1
    if str_contains(header, "HS256") or str_contains(header, "HS384") or str_contains(header, "HS512") [
        warn_line("symmetric alg (HMAC) — confirm the verifying service does not also trust an attacker-supplied public key (alg-confusion risk)")
        warns = warns + 1
    ] else [
        ok_line("not using a symmetric HMAC alg")
    ]

    checks = checks + 1
    if str_contains(payload, "\"exp\"") [
        ok_line("'exp' (expiry) claim present")
    ] else [
        warns = warns + 1
        warn_line("no 'exp' claim — token never expires by itself")
    ]

    checks = checks + 1
    if parts.len() == 3 and str_trim(parts[2].clone()) == "" [
        fails = fails + 1
        bad_line("signature segment is empty")
    ] else [
        ok_line("signature segment present (length only — not verified)")
    ]

    exit(summary("jwtinspect", checks, warns, fails))
]
