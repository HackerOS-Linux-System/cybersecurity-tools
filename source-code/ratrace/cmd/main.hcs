using <0.6>
get <std:string> import <str_trim::str_split::str_contains::str_starts_with::str_replace::str_join::str_repeat::str_to_int::str_ends_with::str_to_float::str_index_of>
get <std:io> import <read_file_or::write_file_ok::file_readable>
get <std:fs> import <list_dir_or_empty::create_dir_ok>

!! ── cybersec prelude (HackerScript) — shared helpers, 0.2 ───────────────────
!! Authorised testing only: run these tools against systems you own or are
!! explicitly permitted to assess.

!! always succeeds at the run_command level (so a non-zero exit inside
!! `cmd`, e.g. a `grep` with no match, never turns into a silent Err /
!! empty string) — the real exit status is not needed by these tools,
!! which only look at stdout text.
fun sh(cmd: Str) -> Str [
    match run_command("/bin/sh".to_string(), ["-c".to_string(), cmd + "; true"]) [
        Ok(o) -> [ end str_trim(o) ]
        Err(_e) -> [ end "" ]
    ]
]

fun have_cmd(name: Str) -> Bool [
    end command_ok(name)
]

fun command_ok(name: Str) -> Bool [
    end sh("command -v " + sh_quote(name) + " >/dev/null 2>&1 && echo y || echo n") == "y"
]

fun sh_quote(s: Str) -> Str [
    end "'" + str_replace(s, "'", "'\\''") + "'"
]

fun arg_has(args: List<Str>, flag: Str) -> Bool [
    let i = 0
    let n = args.len()
    while i < n [
        if args[i] == flag [
            end true
        ]
        i = i + 1
    ]
    end false
]

fun arg_val(args: List<Str>, key: Str, dflt: Str) -> Str [
    let pre: Str = key + "="
    let i = 0
    let n = args.len()
    while i < n [
        let a: Str = args[i].clone()
        if str_starts_with(a.clone(), pre.clone()) [
            end a.slice(pre.len(), a.len())
        ]
        if a == key and i + 1 < n [
            end args[i + 1].clone()
        ]
        i = i + 1
    ]
    end dflt
]

fun positional(args: List<Str>, n: Int) -> Str [
    let seen = 0
    let i = 0
    let total = args.len()
    while i < total [
        let a: Str = args[i].clone()
        if not str_starts_with(a.clone(), "-") [
            seen = seen + 1
            if seen == n [
                end a
            ]
        ]
        i = i + 1
    ]
    end ""
]

fun c_cyan(s: Str) -> Str [ end "\e[36m" + s + "\e[0m" ]
fun c_green(s: Str) -> Str [ end "\e[32m" + s + "\e[0m" ]
fun c_yellow(s: Str) -> Str [ end "\e[33m" + s + "\e[0m" ]
fun c_red(s: Str) -> Str [ end "\e[31m" + s + "\e[0m" ]
fun c_dim(s: Str) -> Str [ end "\e[2m" + s + "\e[0m" ]
fun c_bold(s: Str) -> Str [ end "\e[1m" + s + "\e[0m" ]

fun banner(name: Str, ver: Str, desc: Str) [
    log("")
    log(c_cyan("  | " + name) + c_dim("  v" + ver + "  -  " + desc))
    log(c_dim("  " + str_repeat("-", 58)))
]

fun ok_line(msg: Str) -> Int [
    log("  " + c_green("PASS") + "  " + msg)
    end 0
]

fun warn_line(msg: Str) -> Int [
    log("  " + c_yellow("WARN") + "  " + msg)
    end 1
]

fun bad_line(msg: Str) -> Int [
    log("  " + c_red("FAIL") + "  " + msg)
    end 2
]

fun info_line(msg: Str) [
    log("  " + c_cyan("INFO") + "  " + msg)
]

fun pad_right(s: Str, width: Int) -> Str [
    let out: Str = s.clone()
    while out.len() < width [
        out = out + " "
    ]
    end out
]

fun summary(tool: Str, checks: Int, warns: Int, fails: Int) -> Int [
    log(c_dim("  " + str_repeat("-", 58)))
    let line = tool + ": " + checks.to_string() + " checks, " + warns.to_string() + " warnings, " + fails.to_string() + " failures"
    if fails > 0 [
        log("  " + c_red(line))
        end 2
    ]
    if warns > 0 [
        log("  " + c_yellow(line))
        end 1
    ]
    log("  " + c_green(line))
    end 0
]

fun home_dir() -> Str [
    match env_var("HOME") [
        Some(v) -> [ end v ]
        None -> [ end "/root" ]
    ]
]

fun state_dir(tool: Str) -> Str [
    let d = home_dir() + "/.hackeros/" + tool
    sh("mkdir -p " + sh_quote(d))
    end d
]

fun opt_int_or(o: Option<Int>, dflt: Int) -> Int [
    match o [
        Some(v) -> [ end v ]
        None -> [ end dflt ]
    ]
]

fun arg_int(args: List<Str>, key: Str, dflt: Int) -> Int [
    end opt_int_or(str_to_int(arg_val(args, key, dflt.to_string())), dflt)
]

!! ratrace — process & autostart anomaly hunter (defensive triage, not an AV)
!! Usage: ratrace [--top=15]

fun check_preload() [
    let p = read_file_or("/etc/ld.so.preload", "")
    if str_trim(p) != "" [
        warn_line("/etc/ld.so.preload is set: " + str_trim(p) + "  (classic LD_PRELOAD rootkit vector)")
    ] else [
        ok_line("/etc/ld.so.preload empty or absent")
    ]
]

fun check_hidden_procs() -> Str [
    end sh("for p in /proc/[0-9]*; do pid=$(basename $p); [ -r \"$p/stat\" ] || continue; comm=$(cat \"$p/comm\" 2>/dev/null); exe=$(readlink -f \"$p/exe\" 2>/dev/null); case \"$exe\" in /tmp/*|/dev/shm/*|/var/tmp/*) echo \"$pid $comm $exe\";; esac; done")
]

fun check_listeners_without_binary() -> Str [
    end sh("ss -H -tlnp 2>/dev/null | grep -c 'users:((' ")
]

fun usage() [
    banner("ratrace", "0.2.0", "process & autostart anomaly hunter")
    log("  ratrace [--top=15]")
    log(c_dim("  Heuristic triage only — confirm findings manually before acting."))
]

fun main() [
    let a = args()
    if arg_has(a, "--help") [
        usage()
        end
    ]
    let top = arg_val(a, "--top", "15")
    banner("ratrace", "0.2.0", "process & autostart anomalies")
    let checks = 0
    let warns = 0
    let fails = 0

    checks = checks + 1
    check_preload()

    checks = checks + 1
    let hidden = check_hidden_procs()
    if str_trim(hidden) != "" [
        warns = warns + 1
        warn_line("process(es) running from /tmp, /dev/shm or /var/tmp:")
        log(sh("printf %s " + sh_quote(hidden) + " | sed 's/^/    /'"))
    ] else [
        ok_line("no running process executing from /tmp, /dev/shm or /var/tmp")
    ]

    checks = checks + 1
    let deleted = sh("ls -la /proc/*/exe 2>/dev/null | grep '(deleted)' | wc -l")
    match str_to_int(deleted) [
        Some(v) -> [
            if v > 0 [
                warns = warns + 1
                warn_line(v.to_string() + " running process(es) reference a deleted binary (could be normal after an upgrade, or evasive)")
            ] else [
                ok_line("no process runs from a deleted binary")
            ]
        ]
        None -> [ ]
    ]

    checks = checks + 1
    log(c_bold("  top CPU consumers"))
    log(sh("ps -eo pid,comm,pcpu,pmem --sort=-pcpu 2>/dev/null | head -" + top + " | sed 's/^/    /'"))

    checks = checks + 1
    let cron_root = sh("crontab -l -u root 2>/dev/null | grep -vE '^#|^$'")
    if str_trim(cron_root) != "" [
        info_line("root crontab has entries — review:")
        log(sh("printf %s " + sh_quote(cron_root) + " | sed 's/^/    /'"))
    ] else [
        ok_line("root crontab empty or unreadable")
    ]

    checks = checks + 1
    let rcfiles = sh("grep -l 'curl.*|.*sh\\|wget.*|.*sh\\|base64 -d' /etc/profile.d/*.sh /etc/bash.bashrc /root/.bashrc 2>/dev/null")
    if str_trim(rcfiles) != "" [
        fails = fails + 1
        bad_line("shell-startup files contain pipe-to-shell / base64 decode patterns:")
        log(sh("printf %s " + sh_quote(rcfiles) + " | sed 's/^/    /'"))
    ] else [
        ok_line("no pipe-to-shell patterns in common shell-startup files")
    ]

    exit(summary("ratrace", checks, warns, fails))
]
