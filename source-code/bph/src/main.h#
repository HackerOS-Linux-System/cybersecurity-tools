fn sh(cmd: string) -> string is
    return trim(shell(cmd))
end

fn have_cmd(name: string) -> bool is
    return sh("command -v " + shquote(name) + " >/dev/null 2>&1 && echo y || echo n") == "y"
end

fn arg_has(args: [string], flag: string) -> bool is
    let mut i: int = 1
    while i < array_len(args) is
        if args[i] == flag is
            return true
        end
        i += 1
    end
    return false
end

;; --key=value  or  --key value
fn arg_val(args: [string], key: string, dflt: string) -> string is
    let pre: string = key + "="
    let mut i: int = 1
    while i < array_len(args) is
        let a: string = args[i]
        if starts_with(a, pre) is
            return string_slice(a, string_len(pre), string_len(a))
        end
        if a == key && i + 1 < array_len(args) is
            return args[i + 1]
        end
        i += 1
    end
    return dflt
end

;; n-th positional argument (1-based, flags and their values are not skipped
;; smartly: a positional is any arg that does not start with "-")
fn positional(args: [string], n: int) -> string is
    let mut seen: int = 0
    let mut i: int = 1
    while i < array_len(args) is
        let a: string = args[i]
        if !starts_with(a, "-") is
            seen += 1
            if seen == n is
                return a
            end
        end
        i += 1
    end
    return ""
end

fn banner(name: string, ver: string, desc: string) is
    write("")
    write(cyan_text("  ▌ " + name) + dim_text("  v" + ver + "  ·  " + desc))
    write(dim_text("  " + string_repeat("─", 58)))
end

fn ok_line(msg: string) -> int is
    write("  " + green_text("PASS") + "  " + msg)
    return 0
end

fn warn_line(msg: string) -> int is
    write("  " + yellow_text("WARN") + "  " + msg)
    return 1
end

fn bad_line(msg: string) -> int is
    write("  " + red_text("FAIL") + "  " + msg)
    return 2
end

fn info_line(msg: string) is
    write("  " + cyan_text("INFO") + "  " + msg)
end

;; severity accumulator: 0 ok, 1 warn, 2 fail  → counts
fn tally(sev: int, warns: int, fails: int) -> [int] is
    let mut w: int = warns
    let mut f: int = fails
    if sev == 1 is
        w += 1
    end
    if sev == 2 is
        f += 1
    end
    return [w, f]
end

fn summary(tool: string, checks: int, warns: int, fails: int) -> int is
    write(dim_text("  " + string_repeat("─", 58)))
    let line: string = tool + ": " + to_string(checks) + " checks, " + to_string(warns) + " warnings, " + to_string(fails) + " failures"
    if fails > 0 is
        write("  " + red_text(line))
        return 2
    end
    if warns > 0 is
        write("  " + yellow_text(line))
        return 1
    end
    write("  " + green_text(line))
    return 0
end

fn read_or(path: string, dflt: string) -> string is
    if fs_exists(path) is
        return fs_read(path)
    end
    return dflt
end

fn home_dir() -> string is
    return env_home()
end

fn state_dir(tool: string) -> string is
    let d: string = home_dir() + "/.hackeros/" + tool
    fs_mkdir_all(d)
    return d
end

;; bph — "Become Pentest Hero": containerised distro lab + own-tools suite
;; Rewrite (0.2) of the old Odin backend + Crystal CLI + Go TUI + Python own-tools,
;; 100% H#. Educational use — always get written permission before testing a target.

extern static [c] is
    fn system(cmd: string) -> int
end

fn engine() -> string is
    if have_cmd("podman") is return "podman" end
    if have_cmd("docker") is return "docker" end
    return ""
end

fn container_name(distro: string) -> string is
    return "bph-" + distro
end

fn image_for(distro: string) -> string is
    if distro == "kali" is return "docker.io/kalilinux/kali-rolling:latest" end
    if distro == "blackarch" is return "docker.io/blackarch/blackarch:latest" end
    return ""
end

fn log_dir() -> string is
    return state_dir("bph") + "/logs"
end

fn plugin_dir() -> string is
    return state_dir("bph") + "/plugins"
end

fn warn_tool(tool: string) -> bool is
    return tool == "hydra" || tool == "sqlmap" || tool == "nikto"
end

fn tool_doc(name: string) -> [string] is
    ;; name|description|example
    let docs: [string] = [
        "nmap|Network scanner for discovering hosts and services.|nmap -sV target_ip",
        "metasploit|Framework for exploiting vulnerabilities.|msfconsole",
        "wireshark|Packet analyzer for network traffic.|wireshark",
        "aircrack-ng|Wi-Fi security assessment suite.|airodump-ng wlan0",
        "burpsuite|Web vulnerability scanner.|burpsuite",
        "john|Password cracker.|john hashes.txt",
        "hydra|Online password brute-forcer.|hydra -l user -P passlist ssh://target",
        "nikto|Web server scanner.|nikto -h target.com",
        "sqlmap|SQL injection exploiter.|sqlmap -u target_url",
        "maltego|OSINT visualization tool.|maltego",
        "own-tools|Built-in pentesting toolkit.|bph own-tools port-scan 10.0.0.5"
    ]
    let mut i: int = 0
    while i < array_len(docs) is
        let f: [string] = split(docs[i], "|")
        if f[0] == name is
            return f
        end
        i += 1
    end
    return []
end

