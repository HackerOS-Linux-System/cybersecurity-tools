using <0.6>
get <std:string> import <str_trim::str_split::str_contains::str_starts_with::str_replace::str_join::str_repeat::str_to_int::str_ends_with::str_to_float::str_index_of>
get <std:io> import <read_file_or::write_file_ok::file_readable>
get <std:fs> import <list_dir_or_empty::create_dir_ok>

!! ── cybersec prelude (HackerScript) — shared helpers, 0.2 ───────────────────
!! Authorised testing only: run these tools against systems you own or are
!! explicitly permitted to assess.

!! always succeeds at the run_command level (so a non-zero exit inside
!! `cmd`, e.g. a `grep` with no match, never turns into a silent Err /
!! empty string) — the real exit status is not needed by these tools,
!! which only look at stdout text.
fun sh(cmd: Str) -> Str [
    match run_command("/bin/sh".to_string(), ["-c".to_string(), cmd + "; true"]) [
        Ok(o) -> [ end str_trim(o) ]
        Err(_e) -> [ end "" ]
    ]
]

fun have_cmd(name: Str) -> Bool [
    end command_ok(name)
]

fun command_ok(name: Str) -> Bool [
    end sh("command -v " + sh_quote(name) + " >/dev/null 2>&1 && echo y || echo n") == "y"
]

fun sh_quote(s: Str) -> Str [
    end "'" + str_replace(s, "'", "'\\''") + "'"
]

fun arg_has(args: List<Str>, flag: Str) -> Bool [
    let i = 0
    let n = args.len()
    while i < n [
        if args[i] == flag [
            end true
        ]
        i = i + 1
    ]
    end false
]

fun arg_val(args: List<Str>, key: Str, dflt: Str) -> Str [
    let pre: Str = key + "="
    let i = 0
    let n = args.len()
    while i < n [
        let a: Str = args[i].clone()
        if str_starts_with(a.clone(), pre.clone()) [
            end a.slice(pre.len(), a.len())
        ]
        if a == key and i + 1 < n [
            end args[i + 1].clone()
        ]
        i = i + 1
    ]
    end dflt
]

fun positional(args: List<Str>, n: Int) -> Str [
    let seen = 0
    let i = 0
    let total = args.len()
    while i < total [
        let a: Str = args[i].clone()
        if not str_starts_with(a.clone(), "-") [
            seen = seen + 1
            if seen == n [
                end a
            ]
        ]
        i = i + 1
    ]
    end ""
]

fun c_cyan(s: Str) -> Str [ end "\e[36m" + s + "\e[0m" ]
fun c_green(s: Str) -> Str [ end "\e[32m" + s + "\e[0m" ]
fun c_yellow(s: Str) -> Str [ end "\e[33m" + s + "\e[0m" ]
fun c_red(s: Str) -> Str [ end "\e[31m" + s + "\e[0m" ]
fun c_dim(s: Str) -> Str [ end "\e[2m" + s + "\e[0m" ]
fun c_bold(s: Str) -> Str [ end "\e[1m" + s + "\e[0m" ]

fun banner(name: Str, ver: Str, desc: Str) [
    log("")
    log(c_cyan("  | " + name) + c_dim("  v" + ver + "  -  " + desc))
    log(c_dim("  " + str_repeat("-", 58)))
]

fun ok_line(msg: Str) -> Int [
    log("  " + c_green("PASS") + "  " + msg)
    end 0
]

fun warn_line(msg: Str) -> Int [
    log("  " + c_yellow("WARN") + "  " + msg)
    end 1
]

fun bad_line(msg: Str) -> Int [
    log("  " + c_red("FAIL") + "  " + msg)
    end 2
]

fun info_line(msg: Str) [
    log("  " + c_cyan("INFO") + "  " + msg)
]

fun pad_right(s: Str, width: Int) -> Str [
    let out: Str = s.clone()
    while out.len() < width [
        out = out + " "
    ]
    end out
]

fun summary(tool: Str, checks: Int, warns: Int, fails: Int) -> Int [
    log(c_dim("  " + str_repeat("-", 58)))
    let line = tool + ": " + checks.to_string() + " checks, " + warns.to_string() + " warnings, " + fails.to_string() + " failures"
    if fails > 0 [
        log("  " + c_red(line))
        end 2
    ]
    if warns > 0 [
        log("  " + c_yellow(line))
        end 1
    ]
    log("  " + c_green(line))
    end 0
]

fun home_dir() -> Str [
    match env_var("HOME") [
        Some(v) -> [ end v ]
        None -> [ end "/root" ]
    ]
]

fun state_dir(tool: Str) -> Str [
    let d = home_dir() + "/.hackeros/" + tool
    sh("mkdir -p " + sh_quote(d))
    end d
]

fun opt_int_or(o: Option<Int>, dflt: Int) -> Int [
    match o [
        Some(v) -> [ end v ]
        None -> [ end dflt ]
    ]
]

fun arg_int(args: List<Str>, key: Str, dflt: Int) -> Int [
    end opt_int_or(str_to_int(arg_val(args, key, dflt.to_string())), dflt)
]

!! backupaudit — checks that a backup target exists, is recent, and (heuristically) encrypted
!! Usage: backupaudit <path> [--max-age-hours=26]

fun is_probably_encrypted(path: Str) -> Bool [
    if str_ends_with(path, ".gpg") or str_ends_with(path, ".enc") or str_ends_with(path, ".age") [
        end true
    ]
    let magic = sh("head -c 16 " + sh_quote(path) + " 2>/dev/null | od -An -tx1 | tr -d ' \\n'")
    !! GPG symmetric/pubkey packet tags often start with 0x8c/0x85/0x84; age starts with "age-"
    end str_starts_with(magic, "8c") or str_starts_with(magic, "85") or str_starts_with(magic, "84") or str_starts_with(magic, "616765")
]

fun age_hours(path: Str) -> Int [
    let secs = sh("echo $(( ( $(date +%s) - $(stat -c %Y " + sh_quote(path) + " 2>/dev/null || echo 0) ) / 3600 ))")
    match str_to_int(secs) [
        Some(v) -> [ end v ]
        None -> [ end 999999 ]
    ]
]

fun usage() [
    banner("backupaudit", "0.2.0", "backup existence / freshness / encryption audit")
    log("  backupaudit <file-or-dir> [--max-age-hours=26]")
]

fun main() [
    let a = args()
    let path = positional(a, 1)
    if path == "" or arg_has(a, "--help") [
        usage()
        end
    ]
    let max_age = arg_int(a, "--max-age-hours", 26)
    banner("backupaudit", "0.2.0", path)
    let checks = 0
    let warns = 0
    let fails = 0

    checks = checks + 1
    if not file_readable(path) and sh("[ -d " + sh_quote(path) + " ] && echo y || echo n") != "y" [
        bad_line("not found: " + path)
        exit(2)
    ]
    ok_line("exists: " + path)

    let target: Str = path
    let is_dir = sh("[ -d " + sh_quote(path) + " ] && echo y || echo n") == "y"
    if is_dir [
        target = sh("ls -1t " + sh_quote(path) + " 2>/dev/null | head -1")
        if target == "" [
            checks = checks + 1
            fails = fails + 1
            bad_line("directory is empty — no backup files present")
            exit(summary("backupaudit", checks, warns, fails))
        ]
        target = path + "/" + target
        info_line("newest entry: " + target)
    ]

    checks = checks + 1
    let hrs = age_hours(target)
    if hrs > max_age [
        warns = warns + 1
        warn_line("backup is " + hrs.to_string() + "h old (> " + max_age.to_string() + "h threshold)")
    ] else [
        ok_line("backup is " + hrs.to_string() + "h old (within " + max_age.to_string() + "h threshold)")
    ]

    checks = checks + 1
    let size = sh("stat -c %s " + sh_quote(target) + " 2>/dev/null")
    match str_to_int(size) [
        Some(v) -> [
            if v < 100 [
                warns = warns + 1
                warn_line("backup file is suspiciously small (" + v.to_string() + " bytes)")
            ] else [
                ok_line("size: " + v.to_string() + " bytes")
            ]
        ]
        None -> [
            warns = warns + 1
            warn_line("could not determine size")
        ]
    ]

    checks = checks + 1
    if is_probably_encrypted(target) [
        ok_line("looks encrypted (extension/magic bytes)")
    ] else [
        warns = warns + 1
        warn_line("does not look encrypted — consider GPG/age for off-site copies")
    ]

    exit(summary("backupaudit", checks, warns, fails))
]
