using <0.6>
get <std:string> import <str_trim::str_split::str_contains::str_starts_with::str_replace::str_join::str_repeat::str_to_int::str_ends_with::str_to_float::str_index_of>
get <std:io> import <read_file_or::write_file_ok::file_readable>
get <std:fs> import <list_dir_or_empty::create_dir_ok>

!! ── cybersec prelude (HackerScript) — shared helpers, 0.2 ───────────────────
!! Authorised testing only: run these tools against systems you own or are
!! explicitly permitted to assess.

!! always succeeds at the run_command level (so a non-zero exit inside
!! `cmd`, e.g. a `grep` with no match, never turns into a silent Err /
!! empty string) — the real exit status is not needed by these tools,
!! which only look at stdout text.
fun sh(cmd: Str) -> Str [
    match run_command("/bin/sh".to_string(), ["-c".to_string(), cmd + "; true"]) [
        Ok(o) -> [ end str_trim(o) ]
        Err(_e) -> [ end "" ]
    ]
]

fun have_cmd(name: Str) -> Bool [
    end command_ok(name)
]

fun command_ok(name: Str) -> Bool [
    end sh("command -v " + sh_quote(name) + " >/dev/null 2>&1 && echo y || echo n") == "y"
]

fun sh_quote(s: Str) -> Str [
    end "'" + str_replace(s, "'", "'\\''") + "'"
]

fun arg_has(args: List<Str>, flag: Str) -> Bool [
    let i = 0
    let n = args.len()
    while i < n [
        if args[i] == flag [
            end true
        ]
        i = i + 1
    ]
    end false
]

fun arg_val(args: List<Str>, key: Str, dflt: Str) -> Str [
    let pre: Str = key + "="
    let i = 0
    let n = args.len()
    while i < n [
        let a: Str = args[i].clone()
        if str_starts_with(a.clone(), pre.clone()) [
            end a.slice(pre.len(), a.len())
        ]
        if a == key and i + 1 < n [
            end args[i + 1].clone()
        ]
        i = i + 1
    ]
    end dflt
]

fun positional(args: List<Str>, n: Int) -> Str [
    let seen = 0
    let i = 0
    let total = args.len()
    while i < total [
        let a: Str = args[i].clone()
        if not str_starts_with(a.clone(), "-") [
            seen = seen + 1
            if seen == n [
                end a
            ]
        ]
        i = i + 1
    ]
    end ""
]

fun c_cyan(s: Str) -> Str [ end "\e[36m" + s + "\e[0m" ]
fun c_green(s: Str) -> Str [ end "\e[32m" + s + "\e[0m" ]
fun c_yellow(s: Str) -> Str [ end "\e[33m" + s + "\e[0m" ]
fun c_red(s: Str) -> Str [ end "\e[31m" + s + "\e[0m" ]
fun c_dim(s: Str) -> Str [ end "\e[2m" + s + "\e[0m" ]
fun c_bold(s: Str) -> Str [ end "\e[1m" + s + "\e[0m" ]

fun banner(name: Str, ver: Str, desc: Str) [
    log("")
    log(c_cyan("  | " + name) + c_dim("  v" + ver + "  -  " + desc))
    log(c_dim("  " + str_repeat("-", 58)))
]

fun ok_line(msg: Str) -> Int [
    log("  " + c_green("PASS") + "  " + msg)
    end 0
]

fun warn_line(msg: Str) -> Int [
    log("  " + c_yellow("WARN") + "  " + msg)
    end 1
]

fun bad_line(msg: Str) -> Int [
    log("  " + c_red("FAIL") + "  " + msg)
    end 2
]

fun info_line(msg: Str) [
    log("  " + c_cyan("INFO") + "  " + msg)
]

fun pad_right(s: Str, width: Int) -> Str [
    let out: Str = s.clone()
    while out.len() < width [
        out = out + " "
    ]
    end out
]

fun summary(tool: Str, checks: Int, warns: Int, fails: Int) -> Int [
    log(c_dim("  " + str_repeat("-", 58)))
    let line = tool + ": " + checks.to_string() + " checks, " + warns.to_string() + " warnings, " + fails.to_string() + " failures"
    if fails > 0 [
        log("  " + c_red(line))
        end 2
    ]
    if warns > 0 [
        log("  " + c_yellow(line))
        end 1
    ]
    log("  " + c_green(line))
    end 0
]

fun home_dir() -> Str [
    match env_var("HOME") [
        Some(v) -> [ end v ]
        None -> [ end "/root" ]
    ]
]

fun state_dir(tool: Str) -> Str [
    let d = home_dir() + "/.hackeros/" + tool
    sh("mkdir -p " + sh_quote(d))
    end d
]

fun opt_int_or(o: Option<Int>, dflt: Int) -> Int [
    match o [
        Some(v) -> [ end v ]
        None -> [ end dflt ]
    ]
]

fun arg_int(args: List<Str>, key: Str, dflt: Int) -> Int [
    end opt_int_or(str_to_int(arg_val(args, key, dflt.to_string())), dflt)
]

!! cveradar — local package inventory vs. a small embedded known-vulnerable list
!! (no live CVE feed — this sandbox has no API access; treat as a starting point,
!! always cross-check against your distro's security advisories / osv.dev)
!! Usage: cveradar scan

fun pkg_list() -> Str [
    if have_cmd("dpkg-query") [
        end sh("dpkg-query -W -f='${Package} ${Version}\\n' 2>/dev/null")
    ]
    if have_cmd("rpm") [
        end sh("rpm -qa --qf '%{NAME} %{VERSION}-%{RELEASE}\\n' 2>/dev/null")
    ]
    end ""
]

!! name|max-vulnerable-version(exclusive upper bound, simple numeric compare on major.minor)|advisory
fun watchlist() -> List<Str> [
    end [
        "openssl|3.0.2|historic Heartbleed-class classes patched long ago — verify you are on a maintained branch",
        "sudo|1.9.5|CVE-2021-3156 'Baron Samedit' heap overflow — upgrade sudo",
        "log4j|2.17.0|Log4Shell family (CVE-2021-44228 and follow-ups) if this is a Java app dependency",
        "openssh-server|8.4|review OpenSSH advisories for your branch — keep server patched",
        "bash|4.4|Shellshock-class issues predate this — keep bash patched regardless",
        "curl|7.88|review curl's security advisories for your exact version",
        "xz-utils|5.6.0|CVE-2024-3094 'xz backdoor' — do NOT run 5.6.0/5.6.1, downgrade or patch immediately"
    ]
]

fun major_minor(v: Str) -> Str [
    let parts = str_split(v, ".")
    if parts.len() >= 2 [
        end parts[0].clone() + "." + parts[1].clone()
    ]
    end v
]

fun main() [
    let a = args()
    if positional(a, 1) != "scan" [
        banner("cveradar", "0.2.0", "local package watchlist check")
        log("  cveradar scan")
        log(c_dim("  Static watchlist, not a live feed — verify against your distro's advisories."))
        end
    ]
    banner("cveradar scan", "0.2.0", "installed packages vs. watchlist")
    let inv = pkg_list()
    if inv == "" [
        log(c_red("error:") + " no supported package manager found (dpkg/rpm)")
        exit(1)
    ]
    let wl = watchlist()
    let hits = 0
    let i = 0
    let n = wl.len()
    while i < n [
        let f = str_split(wl[i].clone(), "|")
        let name: Str = f[0].clone()
        let note: Str = f[2].clone()
        let line = sh("printf %s " + sh_quote(inv) + " | grep -i '^" + name + " ' | head -1")
        if str_trim(line) != "" [
            let parts = str_split(str_trim(line), " ")
            let ver: Str = parts[parts.len() - 1].clone()
            log("  " + c_yellow(pad_right(name, 16)) + ver + "  " + c_dim(note))
            hits = hits + 1
        ]
        i = i + 1
    ]
    log(c_dim("  " + str_repeat("-", 58)))
    log("  " + hits.to_string() + " watchlist package(s) installed — review advisories for the exact version")
]
