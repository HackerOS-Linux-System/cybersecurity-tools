fn lang_tag(lang: string) -> string is
    if lang == "H#" is return cyan_text("[H#]") end
    if lang == "HackerScript" is return yellow_text("[HS]") end
    return "\x1b[35m[HL]\x1b[0m"
end

fn find(name: string) -> [string] is
    let reg: [string] = registry()
    let mut i: int = 0
    while i < array_len(reg) is
        let f: [string] = split(reg[i], "|")
        if f[0] == name is
            return f
        end
        i += 1
    end
    return []
end

fn usage() is
    banner("csec", "0.2.0", "HackerOS cybersecurity-tools launcher")
    write("  csec list                tools in this suite, grouped by language")
    write("  csec info <tool>         one-line description")
    write("  csec <tool> [args...]    run a tool (looked up on PATH as csec-<tool> or <tool>)")
    write(dim_text("  Suite mix: H# ~50% · HackerScript ~40% · Hacker Lang ~10% (single-file tools)"))
end

fn main() is
    let args: [string] = env_args()
    let cmd: string = positional(args, 1)
    if cmd == "" || cmd == "help" || cmd == "--help" is
        usage()
        return
    end
    if cmd == "list" is
        banner("csec list", "0.2.0", to_string(array_len(registry())) + " tools")
        let reg: [string] = registry()
        let mut i: int = 0
        while i < array_len(reg) is
            let f: [string] = split(reg[i], "|")
            write("  " + lang_tag(f[2]) + " " + bold(string_pad_right(f[0], 16)) + f[1])
            i += 1
        end
        return
    end
    if cmd == "info" is
        let f: [string] = find(positional(args, 2))
        if array_len(f) == 0 is
            write(red_text("error:") + " unknown tool")
            exit(1)
        end
        write(bold(f[0]) + "  " + lang_tag(f[2]))
        write("  " + f[1])
        return
    end
    let f: [string] = find(cmd)
    if array_len(f) == 0 is
        write(red_text("error:") + " unknown tool or command '" + cmd + "' — see: csec list")
        exit(1)
    end
    if !have_cmd(cmd) is
        write(red_text("error:") + " '" + cmd + "' is not installed / not on PATH")
        exit(1)
    end
    let rest: [string] = tool_tail(args)
    exit(exec_passthru(cmd, rest))
end

fn tool_tail(args: [string]) -> [string] is
    let mut out: [string] = []
    let mut i: int = 2
    while i < array_len(args) is
        out = array_push(out, args[i])
        i += 1
    end
    return out
end

extern static [c] is
    fn system(cmd: string) -> int
end

fn exec_passthru(tool: string, rest: [string]) -> int is
    let mut line: string = shquote(tool)
    let mut i: int = 0
    while i < array_len(rest) is
        line = line + " " + shquote(rest[i])
        i += 1
    end
    return system(line)
end
