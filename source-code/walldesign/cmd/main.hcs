using <0.6>
get <std:string> import <str_trim::str_split::str_contains::str_starts_with::str_replace::str_join::str_repeat::str_to_int::str_ends_with::str_to_float::str_index_of>
get <std:io> import <read_file_or::write_file_ok::file_readable>
get <std:fs> import <list_dir_or_empty::create_dir_ok>

!! ── cybersec prelude (HackerScript) — shared helpers, 0.2 ───────────────────
!! Authorised testing only: run these tools against systems you own or are
!! explicitly permitted to assess.

!! always succeeds at the run_command level (so a non-zero exit inside
!! `cmd`, e.g. a `grep` with no match, never turns into a silent Err /
!! empty string) — the real exit status is not needed by these tools,
!! which only look at stdout text.
fun sh(cmd: Str) -> Str [
    match run_command("/bin/sh".to_string(), ["-c".to_string(), cmd + "; true"]) [
        Ok(o) -> [ end str_trim(o) ]
        Err(_e) -> [ end "" ]
    ]
]

fun have_cmd(name: Str) -> Bool [
    end command_ok(name)
]

fun command_ok(name: Str) -> Bool [
    end sh("command -v " + sh_quote(name) + " >/dev/null 2>&1 && echo y || echo n") == "y"
]

fun sh_quote(s: Str) -> Str [
    end "'" + str_replace(s, "'", "'\\''") + "'"
]

fun arg_has(args: List<Str>, flag: Str) -> Bool [
    let i = 0
    let n = args.len()
    while i < n [
        if args[i] == flag [
            end true
        ]
        i = i + 1
    ]
    end false
]

fun arg_val(args: List<Str>, key: Str, dflt: Str) -> Str [
    let pre: Str = key + "="
    let i = 0
    let n = args.len()
    while i < n [
        let a: Str = args[i].clone()
        if str_starts_with(a.clone(), pre.clone()) [
            end a.slice(pre.len(), a.len())
        ]
        if a == key and i + 1 < n [
            end args[i + 1].clone()
        ]
        i = i + 1
    ]
    end dflt
]

fun positional(args: List<Str>, n: Int) -> Str [
    let seen = 0
    let i = 0
    let total = args.len()
    while i < total [
        let a: Str = args[i].clone()
        if not str_starts_with(a.clone(), "-") [
            seen = seen + 1
            if seen == n [
                end a
            ]
        ]
        i = i + 1
    ]
    end ""
]

fun c_cyan(s: Str) -> Str [ end "\e[36m" + s + "\e[0m" ]
fun c_green(s: Str) -> Str [ end "\e[32m" + s + "\e[0m" ]
fun c_yellow(s: Str) -> Str [ end "\e[33m" + s + "\e[0m" ]
fun c_red(s: Str) -> Str [ end "\e[31m" + s + "\e[0m" ]
fun c_dim(s: Str) -> Str [ end "\e[2m" + s + "\e[0m" ]
fun c_bold(s: Str) -> Str [ end "\e[1m" + s + "\e[0m" ]

fun banner(name: Str, ver: Str, desc: Str) [
    log("")
    log(c_cyan("  | " + name) + c_dim("  v" + ver + "  -  " + desc))
    log(c_dim("  " + str_repeat("-", 58)))
]

fun ok_line(msg: Str) -> Int [
    log("  " + c_green("PASS") + "  " + msg)
    end 0
]

fun warn_line(msg: Str) -> Int [
    log("  " + c_yellow("WARN") + "  " + msg)
    end 1
]

fun bad_line(msg: Str) -> Int [
    log("  " + c_red("FAIL") + "  " + msg)
    end 2
]

fun info_line(msg: Str) [
    log("  " + c_cyan("INFO") + "  " + msg)
]

fun pad_right(s: Str, width: Int) -> Str [
    let out: Str = s.clone()
    while out.len() < width [
        out = out + " "
    ]
    end out
]

fun summary(tool: Str, checks: Int, warns: Int, fails: Int) -> Int [
    log(c_dim("  " + str_repeat("-", 58)))
    let line = tool + ": " + checks.to_string() + " checks, " + warns.to_string() + " warnings, " + fails.to_string() + " failures"
    if fails > 0 [
        log("  " + c_red(line))
        end 2
    ]
    if warns > 0 [
        log("  " + c_yellow(line))
        end 1
    ]
    log("  " + c_green(line))
    end 0
]

fun home_dir() -> Str [
    match env_var("HOME") [
        Some(v) -> [ end v ]
        None -> [ end "/root" ]
    ]
]

fun state_dir(tool: Str) -> Str [
    let d = home_dir() + "/.hackeros/" + tool
    sh("mkdir -p " + sh_quote(d))
    end d
]

fun opt_int_or(o: Option<Int>, dflt: Int) -> Int [
    match o [
        Some(v) -> [ end v ]
        None -> [ end dflt ]
    ]
]

fun arg_int(args: List<Str>, key: Str, dflt: Int) -> Int [
    end opt_int_or(str_to_int(arg_val(args, key, dflt.to_string())), dflt)
]

!! walldesign — nftables firewall ruleset generator & linter
!! Usage: walldesign gen --allow=22,80,443 [--iface=eth0] [--out=/etc/nftables.conf]
!!        walldesign lint [--file=/etc/nftables.conf]
!!        walldesign show-current

fun port_list(spec: Str) -> List<Str> [
    end str_split(spec, ",")
]

fun gen_rules(ports: List<Str>, iface: Str) -> Str [
    let out: Str = "#!/usr/sbin/nft -f\n"
    out = out + "# generated by walldesign — review before applying\n\n"
    out = out + "table inet filter {\n"
    out = out + "  chain input {\n"
    out = out + "    type filter hook input priority 0; policy drop;\n"
    out = out + "    iif \"lo\" accept\n"
    out = out + "    ct state established,related accept\n"
    out = out + "    ct state invalid drop\n"
    out = out + "    ip protocol icmp icmp type echo-request limit rate 5/second accept\n"
    let i = 0
    let n = ports.len()
    while i < n [
        let p: Str = str_trim(ports[i].clone())
        if p != "" [
            out = out + "    tcp dport " + p + " accept"
            if iface != "" [
                out = out + "  # " + iface
            ]
            out = out + "\n"
        ]
        i = i + 1
    ]
    out = out + "    limit rate 10/minute log prefix \"nft-drop: \"\n"
    out = out + "  }\n"
    out = out + "  chain forward {\n"
    out = out + "    type filter hook forward priority 0; policy drop;\n"
    out = out + "  }\n"
    out = out + "  chain output {\n"
    out = out + "    type filter hook output priority 0; policy accept;\n"
    out = out + "  }\n"
    out = out + "}\n"
    end out
]

fun lint_file(path: Str) [
    banner("walldesign lint", "0.2.0", path)
    if not file_readable(path) [
        log("  " + c_red("error:") + " cannot read " + path)
        exit(1)
    ]
    let text = read_file_or(path, "")
    let checks = 0
    let warns = 0
    let fails = 0
    checks = checks + 1
    if str_contains(text, "policy drop") [
        ok_line("input/forward default policy present (drop)")
    ] else [
        warns = warns + 1
        warn_line("no explicit 'policy drop' found — default-allow firewalls are risky")
    ]
    checks = checks + 1
    if str_contains(text, "iif \"lo\" accept") or str_contains(text, "iifname \"lo\" accept") [
        ok_line("loopback traffic explicitly accepted")
    ] else [
        warns = warns + 1
        warn_line("no explicit loopback accept rule")
    ]
    checks = checks + 1
    if str_contains(text, "ct state established") [
        ok_line("stateful established/related accept present")
    ] else [
        fails = fails + 1
        bad_line("missing 'ct state established,related accept' — legitimate replies may be dropped")
    ]
    checks = checks + 1
    if str_contains(text, "0.0.0.0/0") and str_contains(text, "accept") and not str_contains(text, "dport") [
        warns = warns + 1
        warn_line("broad 0.0.0.0/0 accept rule without a port restriction")
    ] else [
        ok_line("no unrestricted 0.0.0.0/0 accept without port filtering")
    ]
    checks = checks + 1
    if str_contains(text, "icmp type echo-request") and str_contains(text, "limit rate") [
        ok_line("ICMP echo-request is rate-limited")
    ] else [
        warns = warns + 1
        warn_line("ICMP echo-request not rate-limited (or absent) — consider limiting ping floods")
    ]
    exit(summary("walldesign lint", checks, warns, fails))
]

fun show_current() [
    banner("walldesign show-current", "0.2.0", "active ruleset")
    if have_cmd("nft") [
        log(sh("nft list ruleset 2>&1"))
    ] elif have_cmd("iptables") [
        log(c_yellow("  nftables not found — showing iptables instead"))
        log(sh("iptables -S 2>&1"))
    ] else [
        log(c_red("  error:") + " neither nft nor iptables found")
        exit(1)
    ]
]

fun usage() [
    banner("walldesign", "0.2.0", "nftables ruleset generator & linter")
    log("  walldesign gen --allow=22,80,443 [--iface=eth0] [--out=path]")
    log("  walldesign lint [--file=/etc/nftables.conf]")
    log("  walldesign show-current")
]

fun main() [
    let a = args()
    let cmd = positional(a, 1)
    if cmd == "" or arg_has(a, "--help") [
        usage()
        end
    ]
    if cmd == "gen" [
        let allow = arg_val(a, "--allow", "22")
        let iface = arg_val(a, "--iface", "")
        let out_path = arg_val(a, "--out", "")
        let rules = gen_rules(port_list(allow), iface)
        if out_path != "" [
            write_file_ok(out_path, rules)
            log(c_green("  written: ") + out_path)
            log(c_dim("  review it, then: nft -c -f " + out_path + "  (check)  and  nft -f " + out_path + "  (apply)"))
        ] else [
            log(rules)
        ]
        end
    ]
    if cmd == "lint" [
        lint_file(arg_val(a, "--file", "/etc/nftables.conf"))
        end
    ]
    if cmd == "show-current" [
        show_current()
        end
    ]
    usage()
    exit(1)
]
